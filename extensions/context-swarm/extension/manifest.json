{
  "manifest_version": 3,
  "name": "ContextSwarm",
  "version": "0.1.0",
  "description": "Deploy extraction agents across browser tabs — parallel web-to-markdown harvesting for LLM context",
  "browser_specific_settings": {
    "gecko": {
      "id": "context-swarm@zeroclaw.dev",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background/service-worker.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
